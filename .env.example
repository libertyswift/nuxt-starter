# Скопируй в .env и подставь свои значения.
# Всё, что начинается с NUXT_PUBLIC_, попадает в runtimeConfig.public
# и переопределяется на рантайме — без пересборки.

# Публичный URL сайта (нужен @nuxtjs/seo для canonical, sitemap и og:image).
# Локально не задаём — @nuxtjs/seo сам определит адрес dev-сервера.
# NUXT_PUBLIC_SITE_URL=https://example.com

# Базовый URL внешнего API
NUXT_PUBLIC_API_BASE_URL=https://jsonplaceholder.typicode.com

# Имя окружения: local | staging | production
NUXT_PUBLIC_ENVIRONMENT=local

# Фичефлаги
NUXT_PUBLIC_FEATURES_ANALYTICS=false
NUXT_PUBLIC_FEATURES_SENTRY=false
NUXT_PUBLIC_FEATURES_DEBUG_MODE=true

# Приватные ключи (только сервер, без префикса NUXT_PUBLIC_)
# NUXT_API_SECRET=

{
  "name": "nuxt-starter",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "dev:staging": "nuxt dev --dotenv .env.staging",
    "build": "nuxt build",
    "build:staging": "nuxt build --dotenv .env.staging",
    "build:production": "nuxt build --dotenv .env.production",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "design:check": "node scripts/check-design-tokens.mjs",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@lucide/vue": "^1.33.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/hints": "^1.1.4",
    "@nuxt/icon": "^2.5.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/scripts": "^1.3.8",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/seo": "^5.3.14",
    "@pinia/nuxt": "^1.0.2",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.51.0",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.124",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.9.0",
    "happy-dom": "^20.11.6",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass-embedded": "^1.103.1",
    "shadcn-nuxt": "^2.8.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
